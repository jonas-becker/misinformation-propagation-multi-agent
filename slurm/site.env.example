# Site-specific settings for slurm/run_chain.slurm and slurm/submit_chains.sh.
# Copy to slurm/site.env (gitignored); it is sourced before the defaults of the launcher, so every value
# can still be overridden per job from the environment (e.g. VLLM_MAX_MODEL_LEN=32768 sbatch ...).
SBATCH_ACCOUNT=your_slurm_account                      # used by slurm/submit_chains.sh (sbatch honours SBATCH_ACCOUNT)
VLLM_IMAGE=/path/to/vllm-openai.sif                    # Apptainer image of the vLLM OpenAI server
SHARED_HF_CACHE_VOLUME=/path/to/shared/hf_cache        # read-only Hugging Face cache shared by the group
LLAMA_70B_HF_CACHE=/path/to/huggingface               # cache that holds meta-llama/Llama-3.3-70B-Instruct
# VENV_PATH=/path/to/venv                              # experiment venv of slurm/run_chain.slurm (default ~/.venvs/misinformed_agents_chains)
# GPT_OSS_TIKTOKEN_DIR=/path/to/tiktoken_encodings      # o200k_base.tiktoken + cl100k_base.tiktoken (compute nodes are offline)
